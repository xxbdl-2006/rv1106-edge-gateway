# Local record of what was removed from the board to free space, kept so a
# deletion can be audited later. Not a project asset.
.board-cleanup/

# Previous board binary saved by verify-osd.sh before it overwrites it.
/v4l2_mpp_encode.prev

# Working directory of scripts/verify-osd.sh: pulled clips and decoded frames.
# Kept on failure so the evidence survives, so it must not be committed.
/.osd-verify/

# Same, for the two newer board scripts.
/.imu-verify/
/.fps-compare/

# Frame grabs from the "is the overlay actually live" spot check: two PNGs
# pulled straight off the RTSP stream. Evidence for one session, not an asset.
/.healthcheck/
